# DU con radio virtual ZMQ (en vez de USRP real) para el laboratorio.
#
# Configurada para escenario MULTI-UE: la DU no habla directamente con los
# terminales, sino con un broker de GNU Radio que reparte la senal de bajada a
# cada UE y agrega las de subida. Ver config/ocudu/NOTAS-MULTIUE.md
#
# Ancho de banda reducido a 10 MHz (antes 20) para aligerar la carga de CPU,
# siguiendo el ejemplo oficial de srsRAN para multi-UE. Implica srate 11.52.

f1ap:
  addrs: 10.0.0.22       # CU-CP
  bind_addrs: 10.0.0.24  # esta DU

f1u:
  socket:
    - bind_addr: 172.20.0.3

# Agente E2 hacia el Near-RT RIC (O-RAN SC, red 10.0.2.0/24)
e2:
  enable_du_e2: true
  addr: 10.0.2.10        # e2term del RIC
  port: 36421
  bind_addr: 10.0.2.31   # IP propia de la DU en la red del RIC
  e2sm_kpm_enabled: true

# Metricas de la DU. Necesarias para que el modelo de servicio E2SM-KPM
# tenga contadores reales que reportar al RIC: sin ellas la conexion E2
# funciona pero las indicaciones llegan vacias.
metrics:
  layers:
    enable_sched: true
    enable_sched_ue: true
    enable_rlc: true
  periodicity:
    du_report_period: 1000

ru_sdr:
  device_driver: zmq
  # tx_port: la DU escucha aqui para ENVIAR muestras (DL) hacia el broker
  # rx_port: la DU se conecta aqui para RECIBIR las muestras (UL) del broker
  #
  # MULTI-UE: el rx_port apunta al BROKER (10.0.0.35), no a un UE concreto.
  # El broker es quien habla con cada terminal.
  device_args: tx_port=tcp://10.0.0.24:2000,rx_port=tcp://10.0.0.35:2001,base_srate=11.52e6
  srate: 11.52
  # tx_gain / rx_gain: NO validos con ZMQ (el validador exige <= 0.0 dB,
  # solo tienen sentido con una radio real tipo USRP). Se omiten.

cell_cfg:
  pci: 1
  dl_arfcn: 368500
  band: 3
  channel_bandwidth_MHz: 10
  common_scs: 15
  plmn: "99970"
  tac: 1
  pdcch:
    dedicated:
      ss2_type: common
      dci_format_0_1_and_1_1: false
    common:
      ss0_index: 0
      coreset0_index: 12
  # PRACH ajustado para multi-UE: con varios terminales accediendo a la vez
  # hay que garantizar preambulos suficientes para que no colisionen.
  #   - total_nof_ra_preambles: 64 es ya el valor por defecto, explicito aqui
  #   - nof_ssb_per_ro: 1 es el unico valor admitido en esta version
  #   - nof_cb_preambles_per_ssb: sin valor por defecto, se fija a 64
  prach:
    prach_config_index: 1
    total_nof_ra_preambles: 64
    nof_ssb_per_ro: 1
    nof_cb_preambles_per_ssb: 64
  pdsch:
    mcs_table: qam64
  pusch:
    mcs_table: qam64

log:
  filename: /tmp/du.log
  all_level: info

pcap:
  mac_enable: enable
  mac_filename: /tmp/du_mac.pcap
